    {
      "name": "Primary action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The page theme supplies the action palette.",
      "html": "<button class=\"ds-action\">Ver mi selección</button>",
      "css": ".ds-action{font:500 16px Inter,sans-serif;display:inline-flex;align-items:center;justify-content:space-between;gap:32px;min-height:56px;padding:15px 24px;background:var(--accent,#28483b);color:var(--on-accent,#fff);border:0;border-radius:0;cursor:pointer;transition:transform .3s cubic-bezier(.16,1,.3,1),opacity .3s}.ds-action:hover{transform:translateY(-3px);opacity:.88}.ds-action:active{transform:scale(.97)}.ds-action:focus-visible{outline:3px solid var(--accent,#28483b);outline-offset:5px}@media(prefers-reduced-motion:reduce){.ds-action{transition:none}}"
    },
    {
      "name": "Text action",
      "kind": "button",
      "refersTo": "button-text",
      "description": "An understated add or anchor action.",
      "html": "<button class=\"ds-text\">Agregar a mi selección <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M5 12h14m-6-6 6 6-6 6\"/></svg></button>",
      "css": ".ds-text{font:16px Inter,sans-serif;display:flex;align-items:center;justify-content:space-between;gap:15px;padding:14px 0;border:0;background:none;color:var(--ink,#252d27);min-height:48px;cursor:pointer}.ds-text svg{width:24px;height:24px;fill:none;stroke:currentColor;stroke-width:1.5;transition:transform .3s}.ds-text:hover svg{transform:translateX(5px)}.ds-text:focus-visible{outline:3px solid var(--accent,#28483b);outline-offset:5px}@media(prefers-reduced-motion:reduce){.ds-text svg{transition:none}}"
    },
    {
      "name": "Service select",
      "kind": "input",
      "refersTo": "select",
      "description": "Native select from appointment forms; browser supplies native option states.",
      "html": "<label class=\"ds-label\">Servicio<select class=\"ds-select\"><option>Corte de autor · $650</option><option>Barba al detalle · $400</option></select></label>",
      "css": ".ds-label{display:block;font:15px Inter,sans-serif;color:var(--ink,#252d27)}.ds-select{font:16px Inter,sans-serif;width:100%;margin-top:8px;border:0;background:var(--bg,#f4f1eb);color:var(--ink,#252d27);padding:15px;min-height:50px;border-radius:0}.ds-select:focus-visible{outline:3px solid var(--accent,#28483b);outline-offset:5px}"
    },
