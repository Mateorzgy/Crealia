      "css": ".ds-chip{font:16px Inter,sans-serif;border:0;padding:12px 24px;min-height:48px;background:var(--surface,#e7e8df);color:var(--ink,#252d27);cursor:pointer;transition:background .25s,color .25s,transform .25s}.ds-chip[aria-pressed=true]{background:var(--ink,#252d27);color:var(--bg,#f4f1eb)}.ds-chip:hover{transform:translateY(-3px)}.ds-chip:focus-visible{outline:3px solid var(--accent,#28483b);outline-offset:5px}@media(prefers-reduced-motion:reduce){.ds-chip{transition:none}}"
